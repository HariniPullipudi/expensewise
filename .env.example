# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Local MongoDB Community Server or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/expense_tracker
# For Atlas, use: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/expense_tracker?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=expense_tracker_secure_session_secret_key_change_in_prod_!#89
SESSION_MAX_AGE_MS=86400000

# Security Settings
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:3000
